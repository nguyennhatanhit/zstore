# ---- Tên và liên hệ của cửa hàng (hiện ở đầu trang, chân trang, tiêu đề, lời chào AI) ----
APP_NAME="ATS E-Store"
SHOP_HOTLINE="1900 0000"
SHOP_EMAIL="hotro@ats-estore.vn"

# ---- Tài khoản nhận chuyển khoản (hiện cho khách chọn "Chuyển khoản ngân hàng") ----
BANK_NAME="Vietcombank"
BANK_ACCOUNT="0123456789"
BANK_OWNER="SHOP ANH NGUYEN TECHSTORE"

# ---- PayOS (lấy tại my.payos.vn > Kênh thanh toán) ----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Địa chỉ HTTPS công khai (Ngrok) – đổi mỗi lần Ngrok cấp địa chỉ mới
PAYOS_SITE_URL=https://abcd.ngrok-free.app
# Chữ đầu nội dung chuyển khoản PayOS (tối đa 3 chữ/số), VD nội dung: ATS15
PAYOS_DESC_PREFIX=ATS

# ---- AI tư vấn (groq | gemini | openai) ----
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=

#Để trống MAIL_USERNAME thì mã được ghi vào logs/mail.log (chạy thử trên máy).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
# Tên người gửi
MAIL_FROM_NAME=
